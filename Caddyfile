{$JAWNIX_DOMAIN:jawnix.com} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8001
	}

	handle /admin/scraper* {
		reverse_proxy api:8001
	}

	# Served from the environment rather than a file on disk.
	#
	# This used to be a bind-mounted ./config.js, which is gitignored — so a
	# fresh checkout had no such file, Docker created the mount point as an
	# empty *directory*, and file_server answered 404. login.html falls back to
	# `window.JAWNIX_CONFIG || {}`, so the Supabase client was built with no URL
	# and no key, and sign-in silently did nothing: page 200, health 200, and no
	# API request even attempted. Production worked only because someone created
	# the file by hand at some point, unrecorded (#103).
	#
	# This block is the only config renderer in the Compose/VPS deployment. The
	# field list must cover the checked-in browser contract
	# — when it first replaced the bind mount it dropped scraperOpsOrigin, which
	# admin.html reads on sign-out to terminate the Scraper session, so signing
	# out of the legacy admin silently stopped revoking privileged Scraper
	# access. tests/test_frontend_shell.py now checks this block against the
	# contract and the legacy Railway renderer.
	#
	# billingEnabled is rendered as a string comparison so any env value yields
	# valid JavaScript — a bare `{$VAR}` would inject `True` or `yes` as a raw
	# token and break every page that loads config.js.
	#
	# Every value here is public by design: shipped to every browser that loads
	# the login page.
	handle /config.js {
		header Content-Type "application/javascript; charset=utf-8"
		header Cache-Control "no-store"
		respond `window.JAWNIX_CONFIG = {
  supabaseUrl: '{$JAWNIX_SUPABASE_URL}',
  supabaseAnonKey: '{$JAWNIX_SUPABASE_ANON_KEY}',
  scraperOpsOrigin: '{$JAWNIX_SCRAPER_OPS_ORIGIN:}',
  billingEnabled: '{$JAWNIX_ENABLE_BILLING:false}' === 'true',
};
` 200
	}

	# Redesigned React shell. FastAPI owns the whole prefix so it can apply the
	# feature flag, serve content-hashed assets immutably, and return the shell
	# document for direct navigation to any application route. While the flag is
	# off this answers 404, keeping the surface non-public before cutover (#71).
	handle /app* {
		reverse_proxy api:8001
	}

	# UI cutover (#71): with JAWNIX_ENABLE_NEW_UI=true the legacy static pages
	# hand their URLs to the React shell. `{$VAR}` is substituted when Caddy
	# parses the config, so flipping the flag means restarting this container
	# (and api) with the new env — which is also the whole rollback: set it
	# false again and the static UI below answers untouched. 302, not 308, so
	# no browser caches a redirect across a rollback. portal-accept keeps its
	# query string because invitation links may carry `?code=`; Supabase hash
	# fragments survive any redirect on their own.
	@newui_root {
		expression `"{$JAWNIX_ENABLE_NEW_UI:false}" == "true"`
		path / /index.html
	}
	redir @newui_root /app/ 302
	@newui_login {
		expression `"{$JAWNIX_ENABLE_NEW_UI:false}" == "true"`
		path /login.html /login
	}
	redir @newui_login /app/sign-in?{query} 302
	@newui_portal {
		expression `"{$JAWNIX_ENABLE_NEW_UI:false}" == "true"`
		path /portal.html /portal
	}
	redir @newui_portal /app/ 302
	@newui_accept {
		expression `"{$JAWNIX_ENABLE_NEW_UI:false}" == "true"`
		path /portal-accept.html
	}
	redir @newui_accept /app/accept-invitation?{query} 302
	@newui_admin {
		expression `"{$JAWNIX_ENABLE_NEW_UI:false}" == "true"`
		path /admin.html
	}
	redir @newui_admin /app/admin 302

	redir / /login.html 302
	redir /index.html /login.html 302
	redir /login /login.html 308
	redir /portal /portal.html 308

	root * /srv/static
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer-when-downgrade
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$JAWNIX_SCRAPER_OPS_DOMAIN:scraper.jawnix.com} {
	encode zstd gzip

	handle /admin/scraper* {
		reverse_proxy api:8001
	}

	respond 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
