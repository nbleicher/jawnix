{$JAWNIX_DOMAIN:jawnix.com} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8001
	}

	handle /admin/scraper* {
		reverse_proxy api:8001
	}

	# Redesigned React shell. FastAPI owns the whole prefix so it can apply the
	# feature flag, serve content-hashed assets immutably, and return the shell
	# document for direct navigation to any application route. While the flag is
	# off this answers 404, keeping the surface non-public before cutover (#71).
	handle /app* {
		reverse_proxy api:8001
	}

	redir / /login.html 302
	redir /index.html /login.html 302
	redir /login /login.html 308
	redir /portal /portal.html 308

	root * /srv/static
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer-when-downgrade
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$JAWNIX_SCRAPER_OPS_DOMAIN:scraper.jawnix.com} {
	encode zstd gzip

	handle /admin/scraper* {
		reverse_proxy api:8001
	}

	respond 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
