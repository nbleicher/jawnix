{$JAWNIX_DOMAIN:jawnix.com} {
	encode zstd gzip

	handle /auth/* {
		reverse_proxy https://{$JAWNIX_BETTER_AUTH_UPSTREAM:jawnix-auth-pro-build-momentum.vercel.app} {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /api/* {
		reverse_proxy api:8001
	}

	# Redesigned React shell. FastAPI owns the whole prefix so it can serve
	# content-hashed assets immutably and return the shell document for direct
	# navigation to any application route.
	handle /app* {
		reverse_proxy api:8001
	}

	# Static-page retirement (P8, after #71 stabilization). The legacy static
	# pages are gone from the image and Compose mounts; only the React shell
	# remains. Their URLs redirect unconditionally to the shell, preserving
	# query strings — invitation `?code=` and sign-in `?next=` values; Supabase
	# hash fragments survive any redirect on their own. 302, not 308, so no
	# browser caches these permanently. The `handle` catch-all sends every other
	# non-shell path to the shell too, so no old bookmark 404s.
	@legacy_login path /login.html /login
	redir @legacy_login /app/sign-in?{query} 302
	@legacy_accept path /portal-accept.html
	redir @legacy_accept /app/accept-invitation?{query} 302
	@legacy_admin path /admin.html
	redir @legacy_admin /app/admin?{query} 302
	@legacy_portal path /portal.html /portal
	redir @legacy_portal /app/?{query} 302
	@legacy_root path / /index.html
	redir @legacy_root /app/?{query} 302

	handle {
		redir * /app/?{query} 302
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer-when-downgrade
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# www has no app of its own. Sending it to the canonical origin keeps sign-in
# cookies and links on one host.
{$JAWNIX_WWW_DOMAIN:www.jawnix.com} {
	redir {$JAWNIX_PUBLIC_BASE_URL:https://jawnix.com}{uri} permanent
}

{$JAWNIX_SCRAPER_OPS_DOMAIN:scraper.jawnix.com} {
	encode zstd gzip

	# The operator UI lives in the branded React shell. The dedicated origin
	# only redirects its entry to the native workspace, which runs under the
	# primary origin's administrator/MFA checks.
	@workspace_entry path / /index.html
	redir @workspace_entry {$JAWNIX_PUBLIC_BASE_URL:https://jawnix.com}/app/admin/acquisition/scraper 302

	respond 404

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
