# Compose must always load the production edge adapter alongside the base file.
# jawnix.com TLS terminates in another product's Caddy (buzz-prod-caddy-1), which
# proxies to a container named `jawnix-caddy` on :8080. docker-compose.edge.yml is
# what creates that container. Omitting it recreates caddy under a different name,
# the edge upstream stops resolving, and every request becomes 502 — that outage
# happened on 2026-07-30. Setting this here means a bare `docker compose up -d`
# cannot reproduce it.
COMPOSE_FILE=docker-compose.yml:docker-compose.edge.yml

# Public application
JAWNIX_DOMAIN=jawnix.com
JAWNIX_PUBLIC_BASE_URL=https://jawnix.com
JAWNIX_ENABLE_BILLING=false
# Redesigned React shell at /app. Keep false until the controlled cutover: while
# it is off the prefix answers 404 and the current static UI is the only surface.
JAWNIX_ENABLE_NEW_UI=false
JAWNIX_FRONTEND_DIST_DIR=./frontend/dist
JAWNIX_COOKIE_SECURE=true
JAWNIX_SESSION_SECRET=GENERATE_A_RANDOM_64_CHARACTER_VALUE
JAWNIX_SESSION_TTL_SECONDS=86400

# PostgreSQL (not exposed publicly)
POSTGRES_DB=jawnix
POSTGRES_USER=jawnix
POSTGRES_PASSWORD=GENERATE_A_LONG_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://jawnix:GENERATE_A_LONG_DATABASE_PASSWORD@postgres:5432/jawnix

# Supabase Auth only
JAWNIX_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
JAWNIX_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Per-administrator challenge throttle. The defaults allow five failures in
# fifteen minutes, followed by a fifteen-minute lock.
JAWNIX_ADMIN_MFA_MAX_ATTEMPTS=5
JAWNIX_ADMIN_MFA_ATTEMPT_WINDOW_SECONDS=900
JAWNIX_ADMIN_MFA_LOCK_SECONDS=900

# Telegram interactive approvals
TELEGRAM_BOT_TOKEN=PASTE_BOTFATHER_TOKEN
TELEGRAM_CHAT_ID=PASTE_PRIVATE_CHAT_OR_GROUP_ID
TELEGRAM_APPROVER_USER_IDS=PASTE_COMMA_SEPARATED_TELEGRAM_USER_IDS
TELEGRAM_WEBHOOK_SECRET=GENERATE_A_RANDOM_WEBHOOK_SECRET

# Resend CSV delivery
RESEND_API_KEY=re_YOUR_KEY
RESEND_WEBHOOK_SECRET=whsec_YOUR_SECRET
JAWNIX_BATCH_FROM_EMAIL=Jawnix <hai@jawnix.com>
JAWNIX_BATCH_DIR=/srv/jawnix/batches
JAWNIX_BATCH_RETENTION_DAYS=30

# Allocation and workers
JAWNIX_GLOBAL_COOLDOWN_DAYS=7
JAWNIX_WORKER_POLL_SECONDS=2
JAWNIX_WORKER_ID=vps-worker-1
JAWNIX_JOB_LOCK_TIMEOUT_SECONDS=900

# Google Maps Scraper synchronization. Leave the command blank when another
# process atomically publishes the persistent dataset before this scheduler.
JAWNIX_SCRAPER_DB_PATH=/data/health_leads/data/leads.db
JAWNIX_SCRAPER_COMMAND=
JAWNIX_SCRAPER_HOUR_UTC=3
JAWNIX_SCRAPER_PUBLICATION_HOUR_UTC=8
JAWNIX_NIGHTLY_REVIEW_HOUR_UTC=9
JAWNIX_NIGHTLY_REVIEW_RETRY_MINUTES=15

# Private Scraper Operations proxy. The URL must be the Scraper VPS WireGuard
# address; the Basic Auth credential is injected server-side and never exposed.
JAWNIX_SCRAPER_OPS_URL=http://10.77.0.2:8090
# Dedicated browser origin isolates upstream Scraper HTML from Jawnix sessions.
JAWNIX_SCRAPER_OPS_ORIGIN=https://scraper.jawnix.com
JAWNIX_SCRAPER_OPS_DOMAIN=scraper.jawnix.com
JAWNIX_SCRAPER_OPS_USER=admin
JAWNIX_SCRAPER_OPS_PASSWORD=GENERATE_A_SEPARATE_UPSTREAM_PASSWORD
JAWNIX_SCRAPER_OPS_TIMEOUT_SECONDS=30
# Keep production decisions visible but non-applying through initial shadow
# acceptance. Unlock both only after the recorded live gates pass.
JAWNIX_RECOMMENDATION_SHADOW_MODE=true
JAWNIX_RECOMMENDATION_APPLY_ENABLED=false

# Encrypted VPS backup repository. The Mac pull job mirrors a second encrypted
# copy to /Volumes/Peely SSD/Jawnix Backups without exposing secrets to Git.
RESTIC_REPOSITORY=/srv/jawnix/restic-repository
RESTIC_PASSWORD=GENERATE_A_SEPARATE_BACKUP_ENCRYPTION_PASSWORD
JAWNIX_BACKUP_HOUR_UTC=4
JAWNIX_BASEBACKUP_DAY_UTC=0
JAWNIX_BACKUP_EXPORT_DIR=/srv/jawnix/backups
JAWNIX_RESTIC_REPOSITORY_DIR=/srv/jawnix/restic-repository

# Mac-only external-drive pull job; do not copy these into the VPS .env.
JAWNIX_VPS_SSH_TARGET=root@159.195.15.51
JAWNIX_EXTERNAL_BACKUP_ROOT=/Volumes/Peely SSD/Jawnix Backups
JAWNIX_EXTERNAL_BACKUP_RETENTION_DAYS=14
