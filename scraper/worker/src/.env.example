# ============================================================
# Copy this to .env and fill in your values.
# Never commit .env to git.
# ============================================================

# --- Required on ALL nodes ---

# Neon managed PostgreSQL connection string
# Get this from: neon.tech → your project → Connection Details
# Use the POOLED connection string for workers
DATABASE_URL=postgres://noah:<password>@ep-xxxx.us-east-1.aws.neon.tech/gmapssaas?sslmode=require

# 32-byte hex encryption key — generate once, use everywhere:
#   openssl rand -hex 32
ENCRYPTION_KEY=your_32_byte_hex_key_here

# --- Worker tuning ---

# Number of concurrent scrapers this worker runs
# Netcup (10 vCore): 4-6  |  Oracle: 2-4  |  Mac Mini: 4-6
CONCURRENCY=4

# Stealth HTTP mode — faster, recommended for VPS
FAST_MODE=true

# Max jobs before worker process restarts (memory hygiene)
MAX_JOBS_PER_CYCLE=100

# Optional: comma-separated proxy URLs
# PROXIES=http://user:pass@proxy1:8080,http://user:pass@proxy2:8080
PROXIES=
