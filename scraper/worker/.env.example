# Copy to .env on box1 (chmod 600). Never commit the real .env.
# DATABASE_URL points at the MANAGED Postgres (same DB the control VPS uses).
DATABASE_URL=postgres://USER:PASS@MANAGED-PG-HOST:5432/gmaps_pro?sslmode=require

# MUST match the HASHID_SALT on the control VPS (job IDs are hashed with it).
HASHID_SALT=CHANGEME-same-as-control-vps

# Proxies: leave EMPTY for the raw-IP baseline arm of the A/B; set a comma-separated
# list for the proxied arm.  e.g. http://user:pass@host:port,http://user:pass@host2:port
PROXIES=

FAST_MODE=false           # start false; A/B fast mode separately later
MAX_JOBS_PER_CYCLE=100    # restart the embedded scraper every N jobs (bounds browser leaks)
DISABLE_TELEMETRY=1

# Spool-and-ship: workers write results here (bind-mounted in docker-compose);
# shipper.py (installed on the host by worker/bootstrap.sh) drains it to Postgres.
GMS_SPOOL_DIR=/data/incoming
