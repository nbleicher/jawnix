[Unit]
Description=Commit the daily Scraper dataset publication
After=gms-enqueue.service network-online.target

[Service]
Type=oneshot
User=scraper
EnvironmentFile=/opt/gms-scale/.env.control
WorkingDirectory=/opt/gms-scale
ExecStart=/opt/gms-scale/venv/bin/python /opt/gms-scale/control/publish_dataset.py
TimeoutStartSec=3600
