[Unit]
Description=Generate the next keyword batch after campaign completion
After=gms-enqueue.service network-online.target

[Service]
Type=oneshot
User=scraper
EnvironmentFile=/opt/gms-scale/.env.control
WorkingDirectory=/opt/gms-scale
ExecStart=/opt/gms-scale/venv/bin/python /opt/gms-scale/control/keyword_rollover.py
